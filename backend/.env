# Configuración del servidor Backend
PORT=8000
HOST=127.0.0.1

# Configuración de Base de Datos SQL Server
# Si deseas usar SQLite, descomenta la siguiente línea y comenta las de SQL Server:
# DATABASE_URL=sqlite:///app/geolog.db

DB_SERVER=localhost\SQLEXPRESS
DB_NAME=db_ingreso_data_v1
DB_TRUSTED=yes
# DB_USER=
# DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server